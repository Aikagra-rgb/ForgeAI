# OpenAI-compatible endpoint (Ollama local default)
FORGEAI_BASE_URL=http://localhost:11434/v1
FORGEAI_API_KEY=ollama
FORGEAI_MODEL=qwen2.5:7b-instruct

# Optional: hosted open-model alternative (e.g., NVIDIA NIM)
# FORGEAI_BASE_URL=https://integrate.api.nvidia.com/v1
# FORGEAI_API_KEY=your_nvidia_nim_api_key
# FORGEAI_MODEL=z-ai/glm-5.3-flash

# Default budget guardrails per factory run
FORGEAI_MAX_TOKENS=400000
FORGEAI_MAX_LATENCY_SECONDS=1200
